# Canonical origin used for canonical URLs, sitemap, Open Graph and JSON-LD.
# Only needed to override the default in astro.config.mjs (preview deploys).
# SITE_URL=https://www.sarozthreadz.com

# Optional. Set this to a hosted form endpoint and the quote form POSTs to it
# instead of opening the visitor's mail client.
#
#   Web3Forms  https://web3forms.com  — free, no account, returns an access key
#              by email. Endpoint: https://api.web3forms.com/submit
#              (add a hidden `access_key` input to the form.)
#   Formspree  https://formspree.io   — free tier, endpoint per form.
#
# Leaving it unset is a valid production choice: the mailto fallback always
# works, costs nothing, and keeps buyers' tech packs out of a third party.
# PUBLIC_FORM_ENDPOINT=
