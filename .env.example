# Canonical origin. On Vercel this is derived automatically; set it only to
# override (e.g. a custom preview domain).
# NEXT_PUBLIC_SITE_URL=https://www.sarozthreadz.com

# --- Enquiry delivery -------------------------------------------------------
# The contact form is a Server Action. It always validates server-side; these
# variables decide where a valid enquiry is delivered.
#
# Option A — Resend (recommended, free tier covers this volume):
# RESEND_API_KEY=re_xxxxxxxxxxxx
# ENQUIRY_TO=sarozthreadz.trade@gmail.com
# ENQUIRY_FROM=Saroz Threadz <enquiries@sarozthreadz.com>
#
# Option B — any webhook (Zapier, Make, a Google Sheet, a CRM):
# FORM_WEBHOOK_URL=https://...
#
# With neither set, the form still validates and tells the buyer to email us
# directly, so an enquiry is never silently lost.
