---
interface Props { trail: { name: string; href: string }[] }
const { trail } = Astro.props;
---
<nav aria-label="Breadcrumb" class="text-[0.8125rem] text-muted">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    <li><a href="/" class="no-underline transition-colors hover:text-ink">Home</a></li>
    {trail.map((item, i) => (
      <li class="flex items-center gap-2">
        <span aria-hidden="true" class="opacity-50">/</span>
        {i === trail.length - 1
          ? <span aria-current="page" class="text-ink-2">{item.name}</span>
          : <a href={item.href} class="no-underline transition-colors hover:text-ink">{item.name}</a>}
      </li>
    ))}
  </ol>
</nav>
