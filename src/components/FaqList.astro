---
import type { Faq } from '@/data/faq';
interface Props { items: Faq[]; class?: string }
const { items, class: cls = '' } = Astro.props;
---
{items.length > 0 && (
  <div class:list={['divide-y divide-line border-y border-line', cls]}>
    {items.map((f) => (
      <details class="faq group">
        <summary>
          <span class="font-serif text-[clamp(1.1rem,1rem+0.4vw,1.35rem)] leading-snug">{f.q}</span>
          <span class="faq-mark" aria-hidden="true"></span>
        </summary>
        <p class="max-w-[70ch] pb-7 pr-10 text-ink-2">{f.a}</p>
      </details>
    ))}
  </div>
)}

<style>
  .faq summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 1.5rem;
    cursor: pointer;
    list-style: none;
    transition: color 0.2s var(--ease-out-expo);
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary:hover { color: var(--accent); }
  .faq-mark {
    position: relative;
    flex: none;
    width: 1rem;
    height: 1rem;
    margin-top: 0.4rem;
  }
  .faq-mark::before,
  .faq-mark::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 1px;
    background: currentColor;
    transition: transform 0.25s var(--ease-out-expo);
  }
  .faq-mark::after { transform: rotate(90deg); }
  .faq[open] .faq-mark::after { transform: rotate(0deg); }
</style>
