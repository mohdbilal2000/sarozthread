---
import { nav, utilityNav, isActive } from '@/lib/nav';
import { company } from '@/data/company';

const path = Astro.url.pathname;
---

<header class="header sticky top-0 z-50 border-b border-transparent transition-colors duration-300">
  <div class="wrap flex min-h-[4.75rem] items-center justify-between gap-6">
    <a href="/" class="group flex shrink-0 items-baseline gap-2 no-underline" aria-label={`${company.name} home`}>
      <span class="font-serif text-[1.3rem] leading-none tracking-[-0.02em]">Saroz&nbsp;Threadz</span>
      <span class="hidden text-[0.6rem] uppercase tracking-[0.28em] text-muted sm:inline">Jaipur</span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {
        nav.map((item) => (
          <div class="group relative">
            <a
              href={item.href}
              class="nav-link"
              aria-current={isActive(item.href, path) ? 'page' : undefined}
              aria-haspopup={item.children ? 'true' : undefined}
            >
              {item.label}
              {item.children && (
                <svg
                  width="9"
                  height="6"
                  viewBox="0 0 9 6"
                  fill="none"
                  aria-hidden="true"
                  class="ml-1 inline-block transition-transform duration-200 group-hover:translate-y-px"
                >
                  <path d="M1 1l3.5 3.5L8 1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                </svg>
              )}
            </a>

            {item.children && (
              <div class="dropdown">
                <ul class="min-w-[15rem] p-2">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="block rounded-[3px] px-3 py-2.5 text-sm no-underline transition-colors duration-150 hover:bg-surface-2"
                        aria-current={path === child.href ? 'page' : undefined}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a href="/contact/" class="btn hidden xl:inline-flex">Request a quote</a>
      <button
        type="button"
        class="nav-toggle lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="drawer lg:hidden" hidden>
    <nav class="wrap pb-10 pt-2" aria-label="Mobile">
      <ul>
        {
          nav.map((item) => (
            <li class="border-b border-line">
              <a href={item.href} class="block py-4 font-serif text-2xl no-underline">
                {item.label}
              </a>
              {item.children && (
                <ul class="-mt-1 pb-4 pl-4">
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} class="block py-1.5 text-sm text-ink-2 no-underline">
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
        {
          utilityNav.map((item) => (
            <li class="border-b border-line">
              <a href={item.href} class="block py-4 font-serif text-2xl no-underline">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/contact/" class="btn mt-7 w-full">Request a quote</a>
    </nav>
  </div>
</header>

<style>
  .header {
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
  }
  .header.is-stuck {
    border-bottom-color: var(--line);
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.75rem;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-2);
    transition: color 0.2s var(--ease-out-expo);
    white-space: nowrap;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.25rem;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease-out-expo);
  }
  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--ink);
  }
  .nav-link:hover::after,
  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
  }

  .dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 3px;
    box-shadow: 0 18px 40px -18px rgb(var(--shadow-color) / 0.28);
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
    transition:
      opacity 0.2s var(--ease-out-expo),
      transform 0.2s var(--ease-out-expo);
  }
  /* Hover opens it; focus-within keeps it usable from the keyboard. */
  .group:hover .dropdown,
  .group:focus-within .dropdown {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .nav-toggle {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0 0.55rem;
    background: none;
    border: 1px solid var(--line);
    border-radius: 3px;
    cursor: pointer;
  }
  .nav-toggle span {
    display: block;
    height: 1px;
    background: var(--ink);
    transition:
      transform 0.3s var(--ease-out-expo),
      opacity 0.2s var(--ease-out-expo);
  }
  .nav-toggle[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }
  /* This scoped rule sits outside Tailwind's utilities layer, so `lg:hidden`
     on the element would lose to it. Hide it here instead. */
  @media (min-width: 64rem) {
    .nav-toggle {
      display: none;
    }
  }

  .drawer {
    position: fixed;
    inset: 4.75rem 0 0 0;
    z-index: 45;
    overflow-y: auto;
    background: var(--paper);
    border-top: 1px solid var(--line);
    overscroll-behavior: contain;
  }
</style>
