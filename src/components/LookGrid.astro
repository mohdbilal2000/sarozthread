---
import { Image } from 'astro:assets';
import { looks } from '@/data/products';

const images = import.meta.glob<{ default: ImageMetadata }>('@/assets/lookbook/*.jpg', { eager: true });

interface Props {
  slugs: string[];
  /** Images above the fold should not be lazy. */
  eagerCount?: number;
  class?: string;
}
const { slugs, eagerCount = 0, class: cls = '' } = Astro.props;

const items = slugs
  .map((slug) => ({
    slug,
    meta: looks[slug],
    img: images[`/src/assets/lookbook/${slug}.jpg`]?.default,
  }))
  .filter((i) => i.meta && i.img);
---
<ul class:list={['grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-4 lg:gap-4', cls]}>
  {items.map((item, i) => (
    <li class="look group relative overflow-hidden rounded-[3px] bg-[#131217]">
      <Image
        src={item.img!}
        alt={`${item.meta.name} — ${item.meta.detail}, manufactured by Saroz Threadz in Jaipur`}
        widths={[320, 480, 720]}
        sizes="(min-width: 1024px) 22vw, (min-width: 640px) 30vw, 47vw"
        loading={i < eagerCount ? 'eager' : 'lazy'}
        class="aspect-[3/4] h-full w-full object-cover transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-[1.045]"
      />
      <div class="look-meta">
        <span class="block text-[0.75rem] uppercase tracking-[0.13em] text-white">{item.meta.name}</span>
        <span class="block text-[0.75rem] tracking-[0.02em] text-white/70">{item.meta.detail}</span>
      </div>
    </li>
  ))}
</ul>

<style>
  .look-meta {
    position: absolute;
    inset: auto 0 0 0;
    padding: 2.5rem 1rem 0.9rem;
    background: linear-gradient(to top, rgb(8 7 10 / 0.85), transparent);
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.35s var(--ease-out-expo),
      transform 0.35s var(--ease-out-expo);
  }
  .look:hover .look-meta,
  .look:focus-within .look-meta { opacity: 1; transform: none; }
  @media (hover: none) { .look-meta { opacity: 1; transform: none; } }
</style>
