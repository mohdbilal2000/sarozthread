---
import { company } from '@/data/company';
import { graph, organizationSchema, placeSchema, websiteSchema, breadcrumbSchema } from '@/lib/schema';

interface Props {
  title: string;
  description: string;
  /** Absolute path, e.g. "/capabilities/embroidery/". Defaults to current URL. */
  path?: string;
  image?: string;
  /** Breadcrumb trail excluding Home, which is prepended. */
  breadcrumbs?: { name: string; href: string }[];
  /** Extra JSON-LD nodes for this page (FAQPage, Service, Article…). */
  schema?: (Record<string, unknown> | null)[];
  noindex?: boolean;
  type?: 'website' | 'article';
  publishedTime?: string;
}

const {
  title,
  description,
  path,
  image = '/og/default.jpg',
  breadcrumbs,
  schema = [],
  noindex = false,
  type = 'website',
  publishedTime,
} = Astro.props;

const site = Astro.site!.origin;
const canonical = new URL(path ?? Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;

// Home page carries the anchor nodes; every other page references them by @id.
const isHome = (path ?? Astro.url.pathname) === '/';
const trail = breadcrumbs?.length ? [{ name: 'Home', href: '/' }, ...breadcrumbs] : null;

const jsonLd = graph(site, [
  organizationSchema(site),
  placeSchema(site),
  websiteSchema(site),
  trail ? breadcrumbSchema(site, trail) : null,
  ...schema,
]);

const fullTitle = isHome ? title : `${title} | ${company.name}`;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{
  !noindex && (
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
  )
}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={company.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content="en" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<meta name="geo.region" content="IN-RJ" />
<meta name="geo.placename" content="Jaipur" />
<meta name="geo.position" content={`${company.geo.lat};${company.geo.lng}`} />

<script type="application/ld+json" is:inline set:html={jsonLd} />
