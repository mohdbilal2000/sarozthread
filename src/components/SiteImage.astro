---
import { Image } from 'astro:assets';

const images = import.meta.glob<{ default: ImageMetadata }>('@/assets/site/*.{jpg,png}', { eager: true });

interface Props {
  name: string;
  alt: string;
  caption?: string;
  ratio?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}
const {
  name,
  alt,
  caption,
  ratio = '16/10',
  widths = [560, 900, 1400],
  sizes = '(min-width: 1024px) 45vw, 92vw',
  loading = 'lazy',
  class: cls = '',
} = Astro.props;

const img = images[`/src/assets/site/${name}.jpg`]?.default ?? images[`/src/assets/site/${name}.png`]?.default;
if (!img) throw new Error(`SiteImage: no asset named "${name}" in src/assets/site/`);
---
<figure class:list={['relative overflow-hidden rounded-[3px] bg-surface-2', cls]}>
  <Image
    src={img}
    alt={alt}
    widths={widths}
    sizes={sizes}
    loading={loading}
    style={`aspect-ratio:${ratio}`}
    class="h-full w-full object-cover"
  />
  {caption && (
    <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[rgb(10_9_12/0.8)] to-transparent px-5 pb-3.5 pt-10 text-[0.75rem] uppercase tracking-[0.14em] text-white">
      {caption}
    </figcaption>
  )}
</figure>
