---
/**
 * Hard specs as a real table. Studies of what AI answer engines cite put
 * tables, lists and explicit statistics well ahead of prose, so every number
 * this factory can state lives in one of these rather than in a sentence.
 */
interface Props {
  caption: string;
  rows: { label: string; value: string }[];
  class?: string;
}
const { caption, rows, class: cls = '' } = Astro.props;
---
<table class={cls}>
  <caption>{caption}</caption>
  <tbody>
    {rows.map((row) => (
      <tr>
        <th scope="row">{row.label}</th>
        <td class="font-medium">{row.value}</td>
      </tr>
    ))}
  </tbody>
</table>
