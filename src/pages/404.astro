---
import Base from '@/layouts/Base.astro';
import ArrowIcon from '@/components/ArrowIcon.astro';
import { capabilities } from '@/data/capabilities';
import { productCategories } from '@/data/products';
---
<Base title="Page not found" description="That page does not exist." path="/404/" noindex>
  <section class="section grid min-h-[60svh] place-items-center">
    <div class="wrap wrap-narrow text-center">
      <p class="eyebrow justify-center">404</p>
      <h1 class="text-h1 mt-6">That page has been unpicked.</h1>
      <p class="mx-auto mt-6 max-w-[48ch] text-ink-2">
        The page you were looking for is not here. Try the factory, a capability, a product category,
        or get in touch directly.
      </p>
      <ul class="mt-10 flex flex-wrap justify-center gap-2.5">
        <li><a href="/factory/" class="chip no-underline hover:border-accent">Factory</a></li>
        {capabilities.slice(0, 3).map((c) => (
          <li><a href={`/capabilities/${c.slug}/`} class="chip no-underline hover:border-accent">{c.name}</a></li>
        ))}
        {productCategories.slice(0, 2).map((p) => (
          <li><a href={`/products/${p.slug}/`} class="chip no-underline hover:border-accent">{p.name}</a></li>
        ))}
      </ul>
      <p class="mt-10">
        <a class="btn" href="/">Back to the front page</a>
      </p>
      <p class="mt-6">
        <a class="link-arrow" href="/faq/">Or read the FAQ <ArrowIcon /></a>
      </p>
    </div>
  </section>
</Base>
