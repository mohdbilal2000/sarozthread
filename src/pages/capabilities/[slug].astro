---
import type { GetStaticPaths } from 'astro';
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import AnswerBlock from '@/components/AnswerBlock.astro';
import SpecTable from '@/components/SpecTable.astro';
import SiteImage from '@/components/SiteImage.astro';
import FaqList from '@/components/FaqList.astro';
import ArrowIcon from '@/components/ArrowIcon.astro';
import Cta from '@/components/Cta.astro';
import { capabilities } from '@/data/capabilities';
import { faqsForPage } from '@/data/faq';
import { faqSchema, serviceSchema } from '@/lib/schema';

export const getStaticPaths = (() =>
  capabilities.map((capability) => ({
    params: { slug: capability.slug },
    props: { capability },
  }))) satisfies GetStaticPaths;

const { capability: c } = Astro.props;
const site = Astro.site!.origin;
const pageFaqs = faqsForPage(`capabilities/${c.slug}`);
const trail = [
  { name: 'Capabilities', href: '/capabilities/' },
  { name: c.name, href: `/capabilities/${c.slug}/` },
];
const others = capabilities.filter((x) => x.slug !== c.slug);
---
<Base
  title={c.name}
  description={c.answer}
  path={`/capabilities/${c.slug}/`}
  breadcrumbs={trail}
  schema={[
    serviceSchema(site, { name: c.name, description: c.answer, url: `/capabilities/${c.slug}/` }),
    faqSchema(pageFaqs),
  ]}
>
  <PageHeader eyebrow="Capability" title={c.name} trail={trail} />

  <section class="section">
    <div class="wrap grid gap-12 lg:grid-cols-[1.15fr_1fr] lg:gap-20">
      <div>
        <AnswerBlock question={c.question} answer={c.answer} as="h2" data-reveal />
        <p class="prose-block mt-10 text-lede" data-reveal="60">{c.intro}</p>

        <ul class="mt-14 space-y-px overflow-hidden rounded-[3px] border border-line bg-line" data-reveal="100">
          {c.bullets.map((b) => (
            <li class="bg-surface p-7">
              <h3 class="font-serif text-[1.2rem] leading-snug">{b.title}</h3>
              <p class="mt-2.5 text-[0.9375rem] text-ink-2">{b.detail}</p>
            </li>
          ))}
        </ul>
      </div>

      <aside class="lg:sticky lg:top-28 lg:self-start" data-reveal="80">
        <SiteImage name={c.image} alt={c.imageAlt} ratio="4/5" />
        <div class="mt-10">
          <SpecTable caption={`${c.name} — at a glance`} rows={c.specs} />
        </div>
        <a class="btn mt-9 w-full" href="/contact/">Ask about {c.name.toLowerCase()}</a>
      </aside>
    </div>
  </section>

  {pageFaqs.length > 0 && (
    <section class="section-tight border-t border-line">
      <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.6fr] lg:gap-20">
        <div>
          <h2 class="text-h2">Questions about {c.name.toLowerCase()}</h2>
        </div>
        <FaqList items={pageFaqs} />
      </div>
    </section>
  )}

  <section class="section-tight border-t border-line">
    <div class="wrap">
      <h2 class="text-h3">Other capabilities</h2>
      <ul class="mt-7 flex flex-wrap gap-3">
        {others.map((o) => (
          <li>
            <a href={`/capabilities/${o.slug}/`} class="chip no-underline transition-colors hover:border-accent hover:text-ink">
              {o.name}
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-9">
        <a class="link-arrow" href="/process/">See the full order process <ArrowIcon /></a>
      </p>
    </div>
  </section>

  <Cta />
</Base>
