---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import ArrowIcon from '@/components/ArrowIcon.astro';
import SiteImage from '@/components/SiteImage.astro';
import SpecTable from '@/components/SpecTable.astro';
import Cta from '@/components/Cta.astro';
import { capabilities } from '@/data/capabilities';
import { facility } from '@/data/company';
import { serviceSchema } from '@/lib/schema';

const site = Astro.site!.origin;
const trail = [{ name: 'Capabilities', href: '/capabilities/' }];
---
<Base
  title="Capabilities"
  description="What Saroz Threadz can actually do: in-house embroidery, partner printing, CAD pattern making, sampling, bulk production on 655 machines, and inline plus final AQL quality control."
  path="/capabilities/"
  breadcrumbs={trail}
  schema={capabilities.map((c) =>
    serviceSchema(site, { name: c.name, description: c.answer, url: `/capabilities/${c.slug}/` }),
  )}
>
  <PageHeader
    eyebrow="Capabilities"
    title="What this factory can actually do."
    lede="Six processes, and a clear line between the ones we own and the one we partner on. A factory that blurs that distinction is usually hiding a subcontractor."
    trail={trail}
  />

  <section class="section">
    <div class="wrap">
      <ul class="grid gap-px overflow-hidden rounded-[3px] border border-line bg-line md:grid-cols-2">
        {capabilities.map((c, i) => (
          <li class="bg-surface" data-reveal={String((i % 2) * 60)}>
            <a href={`/capabilities/${c.slug}/`} class="group flex h-full flex-col p-8 no-underline transition-colors hover:bg-surface-2 sm:p-10">
              <span class="font-serif text-[0.8125rem] tracking-[0.1em] text-accent">{String(i + 1).padStart(2, '0')}</span>
              <h2 class="text-h3 mt-4">{c.name}</h2>
              <p class="mt-4 flex-1 text-[0.9375rem] text-ink-2">{c.answer}</p>
              <span class="link-arrow mt-7 self-start border-0 !pb-0 text-accent">Read more <ArrowIcon /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight band">
    <div class="wrap grid gap-12 lg:grid-cols-2 lg:gap-20">
      <div data-reveal>
        <h2 class="text-h2">Owned, or partnered. Never vague.</h2>
        <p class="prose-block mt-5">
          Every process below is either done on our own floor in Sitapura or run through a named
          partner under our quality control. Buyers get one point of accountability either way.
        </p>
        <SiteImage name="factory-floor" alt="Sewing operation on the Saroz Threadz production floor" class="mt-10" />
      </div>
      <div data-reveal="80">
        <SpecTable
          caption="Processes in house"
          rows={facility.inHouse.map((p) => ({ label: p, value: 'In house' }))}
        />
        <div class="mt-12">
          <SpecTable
            caption="Processes with partners"
            rows={facility.outsourced.map((p) => ({ label: p.process, value: p.note }))}
          />
        </div>
      </div>
    </div>
  </section>

  <Cta />
</Base>
