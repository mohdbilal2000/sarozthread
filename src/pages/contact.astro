---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import FaqList from '@/components/FaqList.astro';
import ArrowIcon from '@/components/ArrowIcon.astro';
import { company, formattedAddress, mapsUrl } from '@/data/company';
import { productCategories } from '@/data/products';
import { faqsForPage } from '@/data/faq';
import { faqSchema } from '@/lib/schema';

const trail = [{ name: 'Contact', href: '/contact/' }];
const pageFaqs = faqsForPage('contact');

// Set PUBLIC_FORM_ENDPOINT (e.g. a Web3Forms or Formspree URL) to post the form
// server-side. With it unset, the form falls back to opening the visitor's own
// mail client — which always works, needs no account, and keeps tech packs out
// of a third party's inbox. See README.
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
---

<Base
  title="Contact"
  description={`Contact ${company.contact.primaryName} at ${company.legalName}, Sitapura Industrial Area, Jaipur. Send a tech pack for a costing and a sampling plan. Phone ${company.contact.phoneDisplay}.`}
  path="/contact/"
  breadcrumbs={trail}
  schema={[faqSchema(pageFaqs)]}
>
  <PageHeader
    eyebrow="Contact"
    title="Tell us what you want made."
    lede="The fastest route to a costing is a tech pack, a target quantity and a delivery window. Email reaches the factory directly — there is no enquiry queue between you and the people who run it."
    trail={trail}
  />

  <section class="section">
    <div class="wrap grid gap-14 lg:grid-cols-[1fr_1.15fr] lg:gap-20">
      <!-- Direct contacts -->
      <div data-reveal>
        <h2 class="text-h2">Direct contacts</h2>

        <dl class="mt-9 space-y-8">
          <div>
            <dt class="text-[0.75rem] uppercase tracking-[0.14em] text-muted">Business contact</dt>
            <dd class="mt-2 text-lede">{company.contact.primaryName}</dd>
            <dd class="mt-1">
              <a href={`tel:${company.contact.phoneE164}`} class="contact-link">{company.contact.phoneDisplay}</a>
            </dd>
            <dd class="mt-1">
              <a href={`mailto:${company.contact.primaryEmail}`} class="contact-link">{company.contact.primaryEmail}</a>
            </dd>
          </div>

          <div>
            <dt class="text-[0.75rem] uppercase tracking-[0.14em] text-muted">Trade &amp; sampling enquiries</dt>
            <dd class="mt-2">
              <a href={`mailto:${company.contact.tradeEmail}`} class="contact-link text-lede">{company.contact.tradeEmail}</a>
            </dd>
          </div>

          <div>
            <dt class="text-[0.75rem] uppercase tracking-[0.14em] text-muted">Factory</dt>
            <dd class="mt-2">
              <address class="space-y-0.5 not-italic leading-relaxed text-ink-2">
                {formattedAddress.map((line) => <div>{line}</div>)}
              </address>
            </dd>
          </div>

          <div>
            <dt class="text-[0.75rem] uppercase tracking-[0.14em] text-muted">Time zone</dt>
            <dd class="mt-2 text-ink-2">{company.contact.timezone}</dd>
          </div>
        </dl>

        <div class="mt-10 flex flex-wrap gap-3">
          <a class="btn btn-ghost" href={`https://wa.me/${company.contact.whatsapp}`} target="_blank" rel="noopener noreferrer">
            WhatsApp
          </a>
          <a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">Open in Maps</a>
        </div>

        <div class="mt-14 border-t border-line pt-9">
          <h3 class="text-h3">Visiting the factory</h3>
          <p class="prose-block mt-4">
            Sitapura Industrial Area is Jaipur's garment zone, a short drive from Jaipur
            International Airport. Let us know when you are travelling and we will arrange a floor
            walk-through and a sample review.
          </p>
        </div>
      </div>

      <!-- RFQ form -->
      <div data-reveal="80">
        <div class="card">
          <h2 class="text-h3">Request a quote</h2>
          <p class="mt-3 text-[0.9375rem] text-ink-2">
            The four fields marked required are what we need to give you a real number rather than a
            range.
          </p>

          <form
            id="rfq"
            class="mt-8"
            method="post"
            action={endpoint || `mailto:${company.contact.tradeEmail}`}
            data-endpoint={endpoint}
            data-mailto={company.contact.tradeEmail}
            novalidate
          >
            <!-- Honeypot. Real people never fill this; bots usually do. -->
            <p class="hidden" aria-hidden="true">
              <label for="f-website">Leave this field empty</label>
              <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </p>

            <div class="grid gap-x-5 sm:grid-cols-2">
              <div class="field">
                <label for="f-company">Company <span class="req">*</span></label>
                <input id="f-company" name="company" type="text" autocomplete="organization" required />
              </div>
              <div class="field">
                <label for="f-name">Your name <span class="req">*</span></label>
                <input id="f-name" name="name" type="text" autocomplete="name" required />
              </div>
              <div class="field">
                <label for="f-email">Email <span class="req">*</span></label>
                <input id="f-email" name="email" type="email" autocomplete="email" required />
              </div>
              <div class="field">
                <label for="f-country">Country</label>
                <input id="f-country" name="country" type="text" autocomplete="country-name" />
              </div>
            </div>

            <div class="field">
              <label for="f-category">Category</label>
              <select id="f-category" name="category">
                {productCategories.map((p) => <option>{p.name}</option>)}
                <option>Other womenswear</option>
              </select>
            </div>

            <div class="grid gap-x-5 sm:grid-cols-2">
              <div class="field">
                <label for="f-qty">Quantity per style <span class="req">*</span></label>
                <input id="f-qty" name="quantity" type="text" placeholder="e.g. 500–2,000 pcs" required />
              </div>
              <div class="field">
                <label for="f-when">Target delivery</label>
                <input id="f-when" name="delivery" type="text" placeholder="e.g. SS27, ship by Nov 2026" />
              </div>
            </div>

            <div class="field">
              <label for="f-msg">Brief</label>
              <textarea
                id="f-msg"
                name="brief"
                rows="5"
                placeholder="Fabric, decoration, number of styles, compliance requirements, anything else we should know."
              ></textarea>
            </div>

            <button class="btn w-full sm:w-auto" type="submit">Send enquiry</button>

            <p id="rfq-status" class="mt-4 text-[0.9375rem]" role="status" aria-live="polite"></p>

            <p class="mt-5 border-t border-line pt-5 text-[0.8125rem] text-muted">
              {
                endpoint
                  ? 'Submitted securely to our enquiry inbox. To attach a tech pack, email it to us directly.'
                  : 'This form opens your own email client with the details filled in — nothing is stored on a third-party server, and your tech pack stays between us.'
              }
              {' '}Prefer email? Write to{' '}
              <a href={`mailto:${company.contact.tradeEmail}`} class="contact-link">{company.contact.tradeEmail}</a>.
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>

  {
    pageFaqs.length > 0 && (
      <section class="section-tight border-t border-line">
        <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.6fr] lg:gap-20">
          <div>
            <h2 class="text-h2">Before you write</h2>
            <p class="mt-5">
              <a class="link-arrow" href="/faq/">
                All questions <ArrowIcon />
              </a>
            </p>
          </div>
          <FaqList items={pageFaqs} />
        </div>
      </section>
    )
  }
</Base>

<style>
  .field {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }
  .field label {
    font-size: 0.75rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .req {
    color: var(--accent);
  }
  .field input,
  .field select,
  .field textarea {
    font: inherit;
    font-size: 0.9375rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 0.8rem 1rem;
    width: 100%;
    transition: border-color 0.2s var(--ease-out-expo);
  }
  .field textarea {
    resize: vertical;
  }
  .field :is(input, select, textarea):focus {
    border-color: var(--accent);
    outline: none;
  }
  .field :is(input, select, textarea)[aria-invalid='true'] {
    border-color: var(--accent);
  }
  .contact-link {
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
    transition:
      border-color 0.2s var(--ease-out-expo),
      color 0.2s var(--ease-out-expo);
  }
  .contact-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>

<script>
  const form = document.getElementById('rfq') as HTMLFormElement | null;
  const status = document.getElementById('rfq-status');

  if (form && status) {
    const endpoint = form.dataset.endpoint ?? '';
    const mailto = form.dataset.mailto ?? '';

    const setStatus = (message: string, ok: boolean) => {
      status.textContent = message;
      status.style.color = ok ? 'var(--ink-2)' : 'var(--accent)';
    };

    type Problem = { field: HTMLInputElement; reason: 'missing' | 'email' };

    const firstProblem = (): Problem | null => {
      let found: Problem | null = null;
      for (const el of Array.from(form.elements)) {
        const field = el as HTMLInputElement;
        if (!field.name || field.name === 'website') continue;
        const missing = field.required && !field.value.trim();
        const badEmail =
          field.type === 'email' && field.value.trim() !== '' && !field.checkValidity();
        field.setAttribute('aria-invalid', String(missing || badEmail));
        if (!found && (missing || badEmail)) {
          found = { field, reason: missing ? 'missing' : 'email' };
        }
      }
      return found;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const problem = firstProblem();
      if (problem) {
        setStatus(
          problem.reason === 'email'
            ? 'That email address does not look right — please check it.'
            : 'Please complete the required fields before sending.',
          false,
        );
        problem.field.focus();
        return;
      }

      const data = new FormData(form);
      if (data.get('website')) return; // honeypot tripped — drop silently

      // No endpoint configured: hand off to the visitor's mail client.
      if (!endpoint) {
        const lines = Array.from(data.entries())
          .filter(([key, value]) => key !== 'website' && String(value).trim())
          .map(([key, value]) => `${key[0]!.toUpperCase()}${key.slice(1)}: ${value}`);
        lines.push('', '(Tech pack attached?)');
        const subject = `Manufacturing enquiry — ${data.get('company') ?? ''}`;
        const href = `mailto:${mailto}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;
        window.location.assign(href);
        setStatus('Opening your email app. Press send there to reach us.', true);
        return;
      }

      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      button.disabled = true;
      setStatus('Sending…', true);

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });
        if (!response.ok) throw new Error(String(response.status));
        form.reset();
        setStatus('Thank you — your enquiry is with us. We reply to every brief.', true);
      } catch {
        setStatus(
          `Something went wrong sending that. Please email ${mailto} directly and we will pick it up.`,
          false,
        );
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
