---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import FaqList from '@/components/FaqList.astro';
import ArrowIcon from '@/components/ArrowIcon.astro';
import Cta from '@/components/Cta.astro';
import { faqs, faqTopics, faqsByTopic } from '@/data/faq';
import { faqSchema } from '@/lib/schema';

const trail = [{ name: 'FAQ', href: '/faq/' }];
---
<Base
  title="Frequently asked questions"
  description="Answers on minimum order quantity, capacity, machinery, sampling, fabrics, certifications, export markets and how to start a manufacturing programme with Saroz Threadz in Jaipur."
  path="/faq/"
  breadcrumbs={trail}
  schema={[faqSchema(faqs)]}
>
  <PageHeader
    eyebrow="FAQ"
    title="Everything buyers ask, answered plainly."
    lede={`${faqs.length} questions, grouped by what you are trying to find out. Where we do not have a figure confirmed, the answer says so rather than guessing.`}
    trail={trail}
  />

  <section class="section">
    <div class="wrap grid gap-12 lg:grid-cols-[16rem_1fr] lg:gap-20">
      <nav aria-label="FAQ topics" class="lg:sticky lg:top-28 lg:self-start">
        <h2 class="text-[0.75rem] uppercase tracking-[0.16em] text-muted">Topics</h2>
        <ul class="mt-5 space-y-2.5">
          {faqTopics.map((t) => (
            <li>
              <a href={`#${t.id}`} class="text-[0.9375rem] no-underline transition-colors hover:text-accent">
                {t.label}
                <span class="ml-2 text-[0.8125rem] text-muted">{faqsByTopic(t.id).length}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-9">
          <a class="link-arrow" href="/contact/">Ask something else <ArrowIcon /></a>
        </p>
      </nav>

      <div class="space-y-16">
        {faqTopics.map((topic) => (
          <section id={topic.id} aria-labelledby={`${topic.id}-heading`}>
            <h2 id={`${topic.id}-heading`} class="text-h2">{topic.label}</h2>
            <p class="mt-3 text-ink-2">{topic.blurb}</p>
            <FaqList items={faqsByTopic(topic.id)} class="mt-7" />
          </section>
        ))}
      </div>
    </div>
  </section>

  <Cta />
</Base>
