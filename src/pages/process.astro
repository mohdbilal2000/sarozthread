---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import FaqList from '@/components/FaqList.astro';
import SiteImage from '@/components/SiteImage.astro';
import ArrowIcon from '@/components/ArrowIcon.astro';
import Cta from '@/components/Cta.astro';
import { processSteps } from '@/data/process';
import { faqsForPage } from '@/data/faq';
import { company } from '@/data/company';
import { faqSchema, howToSchema } from '@/lib/schema';

const site = Astro.site!.origin;
const trail = [{ name: 'How we work', href: '/process/' }];
const pageFaqs = faqsForPage('process');
---
<Base
  title="How we work — tech pack to shipped bulk"
  description="The seven steps from first enquiry to shipped bulk production with Saroz Threadz: costing, sampling, fit approval, pre-production sample, bulk, final AQL inspection, and export from Jaipur."
  path="/process/"
  breadcrumbs={trail}
  schema={[howToSchema(site, processSteps), faqSchema(pageFaqs)]}
>
  <PageHeader
    eyebrow="How we work"
    title="From tech pack to container, in seven steps."
    lede="Each stage has a named owner on our side. You are not passed between departments, and you are told early when something will not work."
    trail={trail}
  />

  <section class="section">
    <div class="wrap">
      <ol class="border-t border-line">
        {processSteps.map((step, i) => (
          <li class="grid gap-3 border-b border-line py-9 md:grid-cols-[4rem_1fr_1.2fr] md:gap-10 md:py-11" data-reveal={String(Math.min(i * 50, 250))}>
            <div class="pt-1 font-serif text-[0.8125rem] tracking-[0.1em] text-accent">
              {String(i + 1).padStart(2, '0')}
            </div>
            <h2 class="text-h3">{step.name}</h2>
            <div>
              <p class="text-[0.9375rem] text-ink-2">{step.text}</p>
              <p class="mt-4 border-l-2 border-line pl-4 text-[0.9375rem] italic text-muted">
                {step.detail}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-tight band">
    <div class="wrap grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <div data-reveal>
        <h2 class="text-h2">What we need from you to quote.</h2>
        <p class="prose-block mt-5">
          The fastest route to a real number is four things. Send them together and you will get a
          costing rather than a list of follow-up questions.
        </p>
        <ol class="mt-8 space-y-3 text-lede">
          <li class="flex gap-4"><span class="font-serif text-accent">1.</span> The garment specification — tech pack, sketch, or a physical sample</li>
          <li class="flex gap-4"><span class="font-serif text-accent">2.</span> Estimated quantity per style and per colour</li>
          <li class="flex gap-4"><span class="font-serif text-accent">3.</span> The fabric quality you have in mind</li>
          <li class="flex gap-4"><span class="font-serif text-accent">4.</span> Your target delivery window</li>
        </ol>
        <p class="mt-9">
          <a class="link-arrow" href="/contact/">Send a brief <ArrowIcon /></a>
        </p>
      </div>
      <div data-reveal="80">
        <SiteImage name="sampling" alt="A garment sample being stitched in the Saroz Threadz sampling room" ratio="4/3" />
      </div>
    </div>
  </section>

  {pageFaqs.length > 0 && (
    <section class="section-tight border-b border-line">
      <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.6fr] lg:gap-20">
        <div>
          <h2 class="text-h2">Questions about working together</h2>
          <p class="mt-5">
            <a class="link-arrow" href="/faq/">All questions <ArrowIcon /></a>
          </p>
        </div>
        <FaqList items={pageFaqs} />
      </div>
    </section>
  )}

  <Cta
    eyebrow="Ready when you are"
    title={`Talk to ${company.contact.primaryName} directly.`}
    body="No enquiry queue, no account manager relaying messages to the floor. You reach the people who run the factory."
  />
</Base>
